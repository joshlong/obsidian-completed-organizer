{
  "name": "completed-organizer",
  "version": "1.0.3",
  "description": "Organize a folder of completed notes into per-year subfolders.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "tsc -noEmit -skipLibCheck && node tests/build.mjs && node --test \"tests/*.test.ts\" \"tests/build/*.test.mjs\"",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "install-plugin": "node bin/install.mjs",
    "release": "bin/release.sh"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "Josh Long",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3"
  }
}
